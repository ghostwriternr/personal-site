---
import Intro from "../components/Intro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import FrameCat from "../components/pixel/FrameCat.astro";
import { chandu, tiny, yoda, yodaPostReach } from "../pixel/sprites/cats";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={site.title} description={site.description} skyline>
    <main
        class="col-span-12 pt-4 md:col-span-10 md:col-start-2 xl:col-span-8 xl:col-start-3"
    >
        <div class="mx-auto w-full max-w-4xl">
            <Intro />
        <div class="relative mt-20 md:mt-14">
            <!-- All three cats, together on the list's top line, Yoda's scratch post at its end -->
            <div
                class="absolute right-0 bottom-full flex items-end gap-6"
                style={`padding-right:${yodaPostReach * yoda.scale}px`}
            >
                <FrameCat cat={chandu} awake="day" plays={["strollLeft"]} />
                <FrameCat
                    cat={tiny}
                    awake="night"
                    plays={["fetch", "tailChase", "zoomiesLeft"]}
                />
                <FrameCat
                    cat={yoda}
                    awake="day"
                    idle="idleByPost"
                    sleep="sleepByPost"
                    plays={["scratch"]}
                />
            </div>
            {
                posts.map((post, idx) => (
                    <a
                        href={`/posts/${post.id}/`}
                        class="group hover:bg-theme-accent animate-fade-in-up border-tertiary hover:border-tertiary -mt-[2px] block border-y-2 py-4 first:mt-0 hover:-mx-4 hover:px-4"
                        style={`animation-delay: ${idx * 25}ms;`}
                    >
                        <div class="flex flex-col justify-between sm:flex-row sm:items-center">
                            <h2 class="text-heading-md flex">
                                {post.data.title}
                                <span class="no-select group-hover:text-text ml-2 text-transparent">
                                    &rarr;
                                </span>
                            </h2>
                            <span class="no-select text-secondary text-body-sm mt-1 font-bold sm:mt-0 sm:shrink-0">
                                <FormattedDate date={post.data.pubDate} />
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
        </div>
    </main>
</BaseLayout>
